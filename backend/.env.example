DATABASE_URL=postgresql+asyncpg://taskmanager:taskmanager@localhost:5432/taskmanager
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development

# Password-reset emails. Leave SMTP_HOST empty locally: the link is logged instead
# (never in production — there an unset SMTP_HOST means no reset mails go out).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
